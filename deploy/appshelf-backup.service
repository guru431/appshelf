[Unit]
Description=appshelf — ночной снимок базы в APPSHELF_BACKUP_DIR
After=network-online.target remote-fs.target

[Service]
Type=oneshot
User=appshelf
Group=appshelf
WorkingDirectory=/var/_sh/appshelf
EnvironmentFile=/etc/appshelf/appshelf.env
UMask=0077
LimitCORE=0
# писем не шлёт — в отличие от appshelf-web и ночной проверки, повышение прав ему не нужно
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
ExecStart=/var/_sh/appshelf/.venv/bin/python -m appshelf backup --daily --keep 14
TimeoutStartSec=10min
