[Unit]
Description=appshelf — ночная проверка новых версий
After=network-online.target remote-fs.target

[Service]
Type=oneshot
User=appshelf
Group=appshelf
WorkingDirectory=/var/_sh/appshelf
EnvironmentFile=/etc/appshelf/appshelf.env
UMask=0077
LimitCORE=0
# Предел на всю cgroup: Python, ipatool, Java (apksigner, проверка каталога F-Droid с -Xmx384m); Chromium здесь нет.
# Худшее законное ~2 ГиБ: Python ~0,2 + разбор каталога F-Droid на пределе 192 МиБ ~1,1 + JVM ~0,5; страничный кэш
# скачиваний ядро вытесняет до OOM. Без предела испорченный APK в 1 ГиБ раздувал процесс до ~9 ГиБ (appshelf-web.service).
MemoryMax=3G
# как у appshelf-web: /usr, /boot, /etc — только чтение, кроме HOME ipatool и токенов Play; без NoNewPrivileges — ради sendmail
ProtectSystem=full
ReadWritePaths=/etc/appshelf/accounts /etc/appshelf/google
PrivateTmp=yes
ExecStart=/var/_sh/appshelf/.venv/bin/python -m appshelf nightly
# скачивания по 30 мин на приложение и ожидание блокировки ipatool
TimeoutStartSec=4h
