# Образец /etc/appshelf/appshelf.env (root:appshelf 0640) — EnvironmentFile служб appshelf.
# Токен каталога полки, перенесённой из первой версии (остальные полки — со своими случайными токенами в базе):
# python3 -c "import secrets; print(secrets.token_hex(16))"
PUB_TOKEN=
# Адрес сайта: из него собираются ссылки установки и manifest
APPSHELF_PUBLIC_BASE=https://apps.example.com
# Кому писать об истёкшем входе в Apple ID и нехватке места (локальный sendmail)
MAIL_TO=owner@example.com
# Apple ID владельца: его первый вход — без приглашения, пока владельца нет; при переходе с первой версии —
# владелец нынешних данных (без него служба не стартует)
APPSHELF_OWNER=owner@example.com
# Необязательно: https_proxy для ipatool, если Apple отклоняет вход с адреса сервера
IPATOOL_PROXY=
# Необязательно: архив IPA вне /var/lib/appshelf; база и tmp — локально. На шаре — подкаталог внутри неё
# (/mnt/archive/appshelf/pub), не сама точка монтирования: пустая точка монтирования — тоже каталог, и при
# несмонтированной шаре IPA легли бы на локальный диск (deploy.sh такое отклоняет)
APPSHELF_PUB=
# Необязательно: каталог ночных снимков базы (appshelf-backup.timer, 05:30, хранятся 14) — не на диске сервера,
# например на шаре рядом с архивом (/mnt/archive/appshelf/backup). Каталог создают один раз заранее, от appshelf:
# при несмонтированной шаре его нет, и снимок не ляжет на локальный диск
APPSHELF_BACKUP_DIR=
# Необязательно: PEM дополнительных доверенных сертификатов — только для загрузчика APK (RuStore, прямые ссылки),
# проверка сертификата не отключается. Без него RuStore не скачивает: его CDN, сайты Сбера и ВТБ — с сертификатом
# НУЦ Минцифры (Russian Trusted Root CA, gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt, SHA-256
# D2:6D:2D:02:…:CA:8E:CF:31); сервер Газпромбанка не отдаёт промежуточный — LiteSSL RSA CA 2025 (TrustAsia).
# Файл — root:appshelf 0640, например /etc/appshelf/sources-ca.pem
APPSHELF_SOURCES_CA=
# Необязательно: вход в панель через Google — клиент OAuth (Web application) из Google Cloud Console, адрес возврата
# <APPSHELF_PUBLIC_BASE>/google/callback; шаги — README, «Вход через Google». Пусто — кнопки нет. Секрет — только здесь
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Необязательно: прокси для Google Play — для страны Google-аккаунта (README, «Google Play»): «имя=url» через пробел,
# url — http://хост:порт или socks5h://[логин:пароль@]хост:порт. У аккаунта хранится имя, выбирает владелец при
# подключении; другие источники через прокси не ходят. Пароль прокси — только здесь
APPSHELF_PROXIES=
