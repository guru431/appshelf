# Образец /etc/appshelf/appshelf.env (root:appshelf 0640) — EnvironmentFile служб appshelf.
# Токен каталога полки, перенесённой из первой версии (остальные полки — со своими случайными токенами в базе):
# python3 -c "import secrets; print(secrets.token_hex(16))"
PUB_TOKEN=
# Адрес сайта: из него собираются ссылки установки и manifest
APPSHELF_PUBLIC_BASE=https://apps.example.com
# Кому писать об истёкшем входе в Apple ID и нехватке места (локальный sendmail)
MAIL_TO=owner@example.com
# Apple ID владельца: его первый вход — без приглашения, пока владельца нет; при переходе с первой версии —
# владелец нынешних данных (без него служба не стартует)
APPSHELF_OWNER=owner@example.com
# Необязательно: https_proxy для ipatool, если Apple отклоняет вход с адреса сервера
IPATOOL_PROXY=
# Необязательно: архив IPA вне /var/lib/appshelf; база и tmp — локально. На шаре — подкаталог внутри неё
# (/mnt/archive/appshelf/pub), не сама точка монтирования: пустая точка монтирования — тоже каталог, и при
# несмонтированной шаре IPA легли бы на локальный диск (deploy.sh такое отклоняет)
APPSHELF_PUB=
