+// appshelf (06-atomic-account-save): the account file is replaced atomically —
+// written to a temp file next to it, flushed to disk, then renamed over
+// `account`. A full disk or a kill mid-write keeps the old file intact instead
+// of leaving an empty one, which reads as "not logged in".
+static bool write_account_file(const std::vector<unsigned char>& blob) {
+    namespace fs = std::filesystem;
+    const fs::path dst = ipt::fs_path(ACCOUNT_FILE);
+    const fs::path tmp = ipt::fs_path(ACCOUNT_FILE + ".tmp");
+    bool ok;
+#ifndef _WIN32
+    int fd = ::open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (fd < 0) return false;
+    size_t off = 0;
+    while (off < blob.size()) {
+        ssize_t n = ::write(fd, blob.data() + off, blob.size() - off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+        off += (size_t)n;
+    }
+    ok = off == blob.size() && ::fsync(fd) == 0;
+    if (::close(fd) != 0) ok = false;
+#else
+    {
+        std::ofstream f(tmp, std::ios::binary | std::ios::trunc);
+        f.write((const char*)blob.data(), (std::streamsize)blob.size());
+        f.flush();
+        ok = (bool)f;
+    }
+#endif
+    std::error_code ec;
+    if (ok) fs::rename(tmp, dst, ec);   // replaces the old file in one step
+    if (ok && !ec) return true;
+    fs::remove(tmp, ec);
+    return false;
+}
