diff --git a/atomic_account.h b/atomic_account.h
new file mode 100644
index 0000000..bd94495
--- /dev/null
+++ b/atomic_account.h
@@ -0,0 +1,71 @@
+#pragma once
+// Write a private temporary file beside account, flush it, then replace account.
+// Every writer owns a different file; a failed write leaves the previous account intact.
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <vector>
+#ifndef _WIN32
+#include <unistd.h>
+#else
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+static bool write_account_file(const std::filesystem::path& dst, const std::vector<unsigned char>& blob) {
+    bool ok = false;
+#ifndef _WIN32
+    const auto pattern = dst.string() + ".tmp.XXXXXX";
+    std::vector<char> name(pattern.begin(), pattern.end());
+    name.push_back('\0');
+    const int fd = ::mkstemp(name.data());  // O_EXCL, mode 0600, no shared/truncated temporary file
+    if (fd < 0) return false;
+    size_t off = 0;
+    while (off < blob.size()) {
+        const ssize_t n = ::write(fd, blob.data() + off, blob.size() - off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+        off += static_cast<size_t>(n);
+    }
+    ok = off == blob.size() && ::fsync(fd) == 0;
+    if (::close(fd) != 0) ok = false;
+    if (ok && ::rename(name.data(), dst.c_str()) == 0) return true;
+    ::unlink(name.data());  // Only this writer's file is ours to remove.
+#else
+    std::filesystem::path tmp;
+    static std::atomic<unsigned long long> sequence{0};
+    HANDLE file = INVALID_HANDLE_VALUE;
+    for (int attempt = 0; attempt < 100; ++attempt) {
+        tmp = dst;
+        tmp += ".tmp." + std::to_string(GetCurrentProcessId()) + "." + std::to_string(sequence++);
+        file = CreateFileW(tmp.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file != INVALID_HANDLE_VALUE) break;
+        if (GetLastError() != ERROR_FILE_EXISTS && GetLastError() != ERROR_ALREADY_EXISTS) return false;
+    }
+    if (file == INVALID_HANDLE_VALUE) return false;
+    size_t off = 0;
+    while (off < blob.size()) {
+        DWORD written = 0;
+        const auto size = static_cast<DWORD>(std::min<size_t>(blob.size() - off, 1U << 20));
+        if (!WriteFile(file, blob.data() + off, size, &written, nullptr) || written == 0) break;
+        off += written;
+    }
+    ok = off == blob.size() && FlushFileBuffers(file);
+    if (!CloseHandle(file)) ok = false;
+    // Concurrent renames (or a briefly open reader) can put the destination in delete-pending state.
+    for (int attempt = 0; ok && attempt < 20; ++attempt) {
+        if (MoveFileExW(tmp.c_str(), dst.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) return true;
+        const auto error = GetLastError();
+        if (error != ERROR_ACCESS_DENIED && error != ERROR_SHARING_VIOLATION) break;
+        Sleep(5);
+    }
+    DeleteFileW(tmp.c_str());
+#endif
+    return false;
+}
