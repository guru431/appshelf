@@ -1425,6 +1425,56 @@ static void cmd_download(const Args& args) {
 
 // ── Help ──────────────────────────────────────────────────────────────────────
 
+// appshelf (03-list-purchases): purchase history of the saved account.
+// JSON: [{"id":…,"bundleId":"…","name":"…","version":"…","purchaseDate":"2024-01-31T10:00:00Z"}]
+static void cmd_list_purchases(const Args& args) {
+    std::string passphrase = get(args, "keychain-passphrase", "");
+
+    Account acc;
+    if (!load_account(acc, passphrase)) {
+        std::cerr << "Not logged in.\n";
+        exit(1);
+    }
+
+    AppStore store(COOKIE_FILE);
+    if (get(args, "debug") == "true") store.set_debug(true);
+
+    std::vector<AppStore::OwnedApp> apps;
+    try {
+        apps = store.list_purchases(acc);
+    } catch (const PasswordTokenExpired&) {
+        silent_relogin(acc, passphrase);
+    } catch (const std::exception& e) {
+        print_red_err(std::string("list-purchases error: ") + e.what() + "\n");
+        exit(1);
+    }
+
+    json out = json::array();
+    for (const auto& a : apps) {
+        char date[32] = "";
+        if (a.purchaseDate > 0) {
+            std::time_t t = (std::time_t)a.purchaseDate;
+            std::tm utc{};
+#ifdef _WIN32
+            gmtime_s(&utc, &t);
+#else
+            gmtime_r(&t, &utc);
+#endif
+            std::strftime(date, sizeof(date), "%Y-%m-%dT%H:%M:%SZ", &utc);
+        }
+        out.push_back({{"id", a.id}, {"bundleId", a.bundleID}, {"name", a.name},
+                       {"version", a.version}, {"purchaseDate", std::string(date)}});
+    }
+    if (g_format == "json") {
+        // names come from Apple; a broken UTF-8 byte must not abort the dump
+        std::cout << out.dump(-1, ' ', false, json::error_handler_t::replace) << "\n";
+    } else {
+        for (const auto& a : out)
+            std::cout << a["id"].get<int64_t>() << "  " << a["bundleId"].get<std::string>() << "  "
+                      << a["name"].get<std::string>() << "  " << a["purchaseDate"].get<std::string>() << "\n";
+    }
+}
