+bool parse_device_mac(const std::string& text, std::vector<uint8_t>& out) {
+    std::string hex;
+    for (char ch : text) {
+        if (ch == ':' || ch == '-') continue;
+        if (!isxdigit((unsigned char)ch)) return false;
+        hex += ch;
+    }
+    if (hex.size() != 12) return false;
+    std::vector<uint8_t> mac(6);
+    for (size_t i = 0; i < 6; ++i)
+        mac[i] = (uint8_t)std::stoul(hex.substr(i * 2, 2), nullptr, 16);
+    if (is_placeholder_mac(mac.data(), mac.size())) return false;
+    out = std::move(mac);
+    return true;
+}
