@@ -548,14 +548,37 @@ static void print_red_err(const std::string& msg) {
 #endif
 }
 
+// appshelf (04-exit-codes): exit codes for the web wrapper —
+//   0 success, 3 session_expired, 4 auth_code_required, 5 license_not_found, 1 anything else.
+// With --format json the error goes to stdout as {"error":"<code>","message":"…"}.
+[[noreturn]] static void fail(int code, const std::string& error, const std::string& message) {
+    if (g_format == "json") {
+        json j;
+        j["error"]   = error;
+        j["message"] = message;
+        std::cout << j.dump(-1, ' ', false, json::error_handler_t::replace) << "\n" << std::flush;
+    } else {
+        print_red_err("Error: " + message + "\n");
+    }
+    exit(code);
+}
+
+[[noreturn]] static void fail_from(const std::exception& e) {
+    if (dynamic_cast<const PasswordTokenExpired*>(&e)) fail(3, "session_expired", e.what());
+    if (dynamic_cast<const AuthCodeRequired*>(&e))     fail(4, "auth_code_required", e.what());
+    if (dynamic_cast<const LicenseRequired*>(&e))      fail(5, "license_not_found", e.what());
+    if (dynamic_cast<const EdgeRejected*>(&e))         fail(1, "edge_rejected", e.what());
+    if (dynamic_cast<const InvalidCredentials*>(&e))   fail(1, "invalid_credentials", e.what());
+    fail(1, "error", e.what());
+}
+
 // appshelf (01-no-stored-password): the password is not stored, so there is
 // nothing to re-login with. Every caller that used to retry after a silent
 // re-login now ends the process with exit code 3 (session expired) and the web
 // wrapper asks the owner to log in again. Kept as a function so the call sites
 // stay untouched and the patch rebases onto new upstream commits easily.
 [[noreturn]] static void session_expired() {
-    print_red_err("Error: session expired. Please log in again.\n");
-    exit(3);
+    fail(3, "session_expired", "session expired, log in again");
 }
 
