 // appshelf (03-list-purchases): purchase history of the saved account.
 // JSON: [{"id":…,"bundleId":"…","name":"…","version":"…","purchaseDate":"2024-01-31T10:00:00Z"}]
+static void cmd_import_account() {
+#ifdef __linux__
+    if (geteuid() == 0) fail(1, "usage", "run account import as the application user");
+#endif
+    std::string input;
+    char chunk[4096];
+    while (std::cin) {
+        std::cin.read(chunk, sizeof(chunk));
+        input.append(chunk, static_cast<size_t>(std::cin.gcount()));
+        if (input.size() > (1U << 20)) fail(1, "usage", "account import too large");
+    }
+    Account acc;
+    try {
+        json value = json::parse(input);
+        secure_zero(input.data(), input.size());
+        if (!value.is_object() || value.contains("password"))
+            fail(1, "usage", "password-free account import required");
+        acc.email = value.value("email", "");
+        acc.name = value.value("name", "");
+        acc.directoryServicesID = value.value("directoryServicesIdentifier", "");
+        acc.storeFront = value.value("storeFront", "");
+        acc.pod = value.value("pod", "");
+        const std::string token = value.value("passwordToken", "");
+        if (acc.email.empty() || token.empty() || acc.storeFront.empty()
+            || !std::regex_match(acc.directoryServicesID, std::regex("[0-9]{1,32}"))
+            || (!acc.pod.empty() && !std::regex_match(acc.pod, std::regex("[0-9]{1,3}"))))
+            fail(1, "usage", "incomplete authenticated account");
+        acc.passwordToken.set(token);
+    } catch (...) {
+        secure_zero(input.data(), input.size());
+        fail(1, "usage", "invalid authenticated account");
+    }
+    Account previous;
+    if (load_account(previous)) {
+        if (previous.directoryServicesID != acc.directoryServicesID)
+            fail(1, "usage", "account identity does not match HOME");
+        acc.kbsync = previous.kbsync;
+        acc.fserial = previous.fserial;
+        if (acc.pod.empty()) acc.pod = previous.pod;
+        if (acc.name.empty()) acc.name = previous.name;
+        acc.firstName = previous.firstName;
+        acc.lastName = previous.lastName;
+    }
+    if (!save_account(acc)) fail(1, "save_failed", "failed to save authenticated account");
+    std::string storefront;
+    try { storefront = country_code_from_storefront(acc.storeFront); }
+    catch (...) { storefront = acc.storeFront; }
+    std::cout << json{{"success", true}, {"name", acc.name}, {"email", acc.email},
+                      {"storefront", storefront}, {"passwordStored", false}}.dump() << '\n';
+}
