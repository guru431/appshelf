diff --git a/native_commerce.h b/native_commerce.h
new file mode 100644
index 0000000..219727d
--- /dev/null
+++ b/native_commerce.h
@@ -0,0 +1,103 @@
+#pragma once
+// Native Store sessions require a per-request AMD device proof. Only commerce
+// POSTs carrying the saved token use it; legacy sessions retain their HTTP path.
+#include <map>
+#include <string>
+#include <stdexcept>
+#include <nlohmann/json.hpp>
+#include "ipatool.h"
+#ifdef __linux__
+#include <filesystem>
+#include <chrono>
+#include <cerrno>
+#include <cstdlib>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static std::map<std::string,std::string> parse_native_store_proof(const std::string& raw) {
+    const auto data=nlohmann::json::parse(raw,nullptr,false);
+    if (!data.is_object() || data.size()!=2)
+        throw std::runtime_error("native Store device proof unavailable");
+    std::map<std::string,std::string> result;
+    for (const char* key : {"X-Apple-AMD","X-Apple-AMD-M"}) {
+        if (!data.contains(key) || !data[key].is_string())
+            throw std::runtime_error("native Store device proof unavailable");
+        const auto value=data[key].get<std::string>();
+        if (value.empty() || value.size()>8192 || value.find_first_of("\r\n")!=std::string::npos
+            || value.find('\0')!=std::string::npos)
+            throw std::runtime_error("native Store device proof unavailable");
+        result.emplace(key,value);
+    }
+    return result;
+}
+
+static std::string read_native_store_proof(const std::string& helper,const std::string& url) {
+    struct stat metadata{};
+    const auto parent=std::filesystem::path(helper).parent_path();
+    if (lstat(helper.c_str(),&metadata)!=0 || !S_ISREG(metadata.st_mode) || metadata.st_uid!=0
+        || (metadata.st_mode&0002) || access(helper.c_str(),W_OK)==0 || access(parent.c_str(),W_OK)==0)
+        throw std::runtime_error("native Store helper permissions are unsafe");
+    int pipefd[2];
+    if (pipe2(pipefd,O_CLOEXEC)!=0) throw std::runtime_error("native Store proof pipe unavailable");
+    const auto pid=fork();
+    if (pid<0) {
+        close(pipefd[0]); close(pipefd[1]);
+        throw std::runtime_error("native Store helper unavailable");
+    }
+    if (pid==0) {
+        const int nullfd=open("/dev/null",O_RDWR);
+        if (nullfd<0 || dup2(nullfd,STDIN_FILENO)<0 || dup2(nullfd,STDERR_FILENO)<0
+            || dup2(pipefd[1],STDOUT_FILENO)<0) _exit(1);
+        close(nullfd); close(pipefd[0]); close(pipefd[1]);
+        execl(helper.c_str(),helper.c_str(),"--store-headers",url.c_str(),static_cast<char*>(nullptr));
+        _exit(1);
+    }
+    close(pipefd[1]);
+    std::string raw;
+    bool ok=true;
+    const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(60);
+    while (true) {
+        const auto remaining=std::chrono::duration_cast<std::chrono::milliseconds>(deadline-std::chrono::steady_clock::now()).count();
+        if (remaining<=0) { ok=false; break; }
+        pollfd pfd{pipefd[0],POLLIN,0};
+        const int ready=poll(&pfd,1,static_cast<int>(remaining));
+        if (ready<0 && errno==EINTR) continue;
+        if (ready<=0) { ok=false; break; }
+        char chunk[4096];
+        const auto size=read(pipefd[0],chunk,sizeof(chunk));
+        if (size<0 && errno==EINTR) continue;
+        if (size<0) { ok=false; break; }
+        if (size==0) break;
+        raw.append(chunk,static_cast<size_t>(size));
+        if (raw.size()>32768) { ok=false; break; }
+    }
+    close(pipefd[0]);
+    if (!ok) kill(pid,SIGKILL);
+    int status=0;
+    pid_t waited;
+    do { waited=waitpid(pid,&status,0); } while (waited<0 && errno==EINTR);
+    if (!ok || waited!=pid || !WIFEXITED(status) || WEXITSTATUS(status)!=0)
+        throw std::runtime_error("native Store device proof unavailable");
+    return raw;
+}
+#endif
+
+static std::map<std::string,std::string> native_commerce_headers(
+    const std::string& url,const std::map<std::string,std::string>& headers) {
+#ifdef __linux__
+    const char* home=getenv("HOME");
+    if (!home || !std::filesystem::exists(std::filesystem::path(home)/".ipatool"/"adi-state")) return headers;
+    const auto helper=std::filesystem::read_symlink("/proc/self/exe").parent_path()/"ipatool-auth";
+    const auto proof=parse_native_store_proof(read_native_store_proof(helper.string(),url));
+    auto result=headers;
+    for (const auto& [key,value] : proof) result[key]=value;
+    result["User-Agent"]=CONFIGURATOR_UA;
+    return result;
+#else
+    return headers;
+#endif
+}
