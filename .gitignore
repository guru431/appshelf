# Secrets
.env
.env.*
!.env.example
# Денилисты публикации в github (github-push) — локальные, в них внутренние имена
.sanitize-patterns*
.github-push-deny
# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
# Claude / IDE (копии claude-switch, локальные настройки)
.claude/
.idea/
.vscode/
# Рабочая копия upstream ipatool-cpp для правки патчей
.work/
# Рабочие файлы исполнения планов (superpowers)
.superpowers/
# Планы реализации — локально: в публичный github не уезжают (.github-push-deny)
docs/superpowers/plans/

# Private project journals and archives stay local.
[Ff][Ii][Nn][Dd][Ii][Nn][Gg][Ss]*.[mM][dD]
[Ii][Dd][Ee][Aa][Ss]*.[mM][dD]
[Ff][Ii][Nn][Dd][Ii][Nn][Gg][Ss]*.[pP][dD][fF]
[Ii][Dd][Ee][Aa][Ss]*.[pP][dD][fF]
