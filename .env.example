# Копия — .env (не в git). Нужен deploy/deploy.sh и живым тестам (pytest -m integration).
# Сервер, на который выкладывается appshelf: пользователь с sudo.
APPSHELF_SSH=admin@server.example
APPSHELF_SSH_PORT=22
APPSHELF_SSH_KEY=~/.ssh/id_ed25519
# Группа каталога кода на сервере — только чтение (по умолчанию root); appshelf в неё входить не должен
APPSHELF_CODE_GROUP=root
# Живой тест RuStore (tests/test_apk_live.py) — PEM корня НУЦ для CDN RuStore, как APPSHELF_SOURCES_CA на сервере
#APPSHELF_SOURCES_CA=C:/certs/russian_trusted_root_ca.pem
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (вход через Google) — не здесь: только в /etc/appshelf/appshelf.env на сервере
# Живой тест Google Play (tests/test_android_play_live.py) — id Google-аккаунта, подключённого к Play на сервере
#APPSHELF_PLAY_TEST_GID=1
# APPSHELF_PROXIES (прокси Google Play) — тоже только в /etc/appshelf/appshelf.env
# Хост сборки bin/ipatool (deploy/build-ipatool.sh): Docker и sudo без пароля. Не задан — собирать на самом сервере
#APPSHELF_BUILD_SSH=admin@docker.example
#APPSHELF_BUILD_SSH_PORT=22
#APPSHELF_BUILD_SSH_KEY=~/.ssh/id_ed25519
